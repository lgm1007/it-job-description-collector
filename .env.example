# .env 로 복사해서 사용합니다. 모든 값은 생략 가능하며, 아래는 기본값입니다.

# 데이터(SQLite DB, 전용 Chrome 프로필, browser-harness 상태)를 저장할 폴더
JDC_DATA_DIR=.data

# 웹앱이 읽는 Supabase DB의 연결 문자열. 비워 두면 로컬에만 저장합니다.
# 대시보드의 Connect > Session pooler에서 복사합니다 (README의 'Supabase 준비' 참고).
# 비밀번호가 들어 있으니 .env에만 넣고 공유하지 마세요.
# JDC_SUPABASE_DB_URL=postgresql://postgres.<프로젝트ID>:<DB 비밀번호>@<풀러 주소>:5432/postgres

# 수집할 사이트 (쉼표 구분): wanted,remember,jobplanet,jumpit,saramin,jobkorea
JDC_SOURCES=wanted,remember,jobplanet,jumpit,saramin,jobkorea

# 전용 Chrome (browser-harness가 CDP로 연결)
# JDC_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
JDC_CDP_PORT=9333
JDC_HEADLESS=1
# 수집이 끝나면 직접 띄운 Chrome을 종료할지 (0이면 계속 띄워 둠)
JDC_CLOSE_BROWSER=1

# 요청 간격(초)과 상세 페이지 동시 요청 수 — 사이트에 부담을 주지 않도록 보수적으로 잡았습니다.
JDC_REQUEST_DELAY=0.7
JDC_DETAIL_CONCURRENCY=3
# 한 번의 수집에서 사이트별로 새로 가져올 상세 정보 최대 개수
JDC_MAX_DETAILS=6000
# 목록에서 사라진 공고를 사이트별로 몇 개까지 상세 페이지로 재확인할지
JDC_VERIFY_LIMIT=600
