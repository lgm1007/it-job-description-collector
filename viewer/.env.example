# .env.local로 복사해서 사용합니다. Vercel에서는 프로젝트의 Environment Variables에 같은 이름으로 넣습니다.
# 값은 Supabase 대시보드의 Project Settings > API Keys에 있습니다.
# 이 키는 브라우저에 그대로 노출되는 공개용 키이고, 데이터는 RLS가 막아 줍니다. secret 키는 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=https://<프로젝트ID>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
